{
  "name": "nexus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @nexus/web",
    "build": "npm run build -w @nexus/web",
    "build:single": "npm run build:single -w @nexus/web",
    "test": "npm run test -w @nexus/core && npm run test -w @nexus/web",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p packages/core && tsc -p apps/web --noEmit",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "tsx": "^4.23.15"
  }
}
