# Nexus — environment variables. Copy to .env for server-side use. Never commit real keys.
# The demo build needs NONE of these; it makes no AI or Google API calls.

# Optional AI (server-side only; never exposed to the browser build)
NEXUS_AI_PROVIDER=        # anthropic | openai
NEXUS_AI_MODEL=           # required if a provider is set, e.g. the model id you have access to
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Connected mode (designed, not implemented in this build)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
